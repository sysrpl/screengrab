<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:v="using:screengrab.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="screengrab.Views.AboutWindow"
        Title="About"
        SizeToContent="Height"
        Width="520"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Grid#DetailsGrid > TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource MintDimTextBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <StackPanel Classes="dialogButtons" DockPanel.Dock="Bottom">
            <Button Content="Copy build information" Click="CopyDetails_Click" />
            <Button Content="Close" Classes="accent" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>

        <StackPanel Margin="24,20,24,4" Spacing="12">
            <Grid ColumnDefinitions="Auto,*">
                <!-- The app icon -->
                <Image Source="/resources/icon.png" Width="48" Height="48"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="NameText" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource MintDimTextBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock TextWrapping="Wrap"
                       Text="Takes screenshots with Print Screen, even while another program's menu is open, which Cinnamon's own screenshot shortcut can't do." />
            <TextBlock TextWrapping="Wrap"
                       Text="Select part of the screenshot or one monitor, then copy it or save it as a PNG. Screen Grab waits in the system tray until the next time you press the key." />

            <TextBlock Text="Build information" FontWeight="Bold" Margin="0,6,0,0" />
            <!-- A fixed height with a vertical scroll bar, so the build details don't make the window
                 tall. Long lines (the operating system) wrap rather than scroll sideways. -->
            <Border Background="{DynamicResource MintViewBrush}" CornerRadius="3">
                <ScrollViewer x:Name="DetailsScroller" Height="96"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <!-- Selectable, so it can be copied into a bug report. -->
                    <Grid x:Name="DetailsGrid" ColumnDefinitions="Auto,*" Margin="10,8" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</v:DialogWindow>
